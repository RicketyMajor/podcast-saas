# ─────────────────────────────────────────────────────────────
# Next.js → copy to .env.local (never commit .env.local)
# ─────────────────────────────────────────────────────────────

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Vercel only (production): Convex deploy key
# CONVEX_DEPLOY_KEY=

# ─────────────────────────────────────────────────────────────
# Convex → NOT in .env.local
# Set with `npx convex env set NAME value` (add --prod for production)
# ─────────────────────────────────────────────────────────────
# Convex Auth (SITE_URL, JWT_PRIVATE_KEY, JWKS are set by `npx @convex-dev/auth`)
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=
# JWKS=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
#
# AI (free tiers)
# GOOGLE_TTS_API_KEY=            (Google Cloud project WITH billing, TTS API only)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=          (Workers AI permission)
# GEMINI_API_KEY=                (AI Studio project WITHOUT billing)
